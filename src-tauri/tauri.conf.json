{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActivityUI",
  "version": "0.1.0",
  "identifier": "com.activityui.app",
  "build": {
    "beforeDevCommand": "npm run tauri:frontend-dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ActivityUI",
        "width": 1440,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
